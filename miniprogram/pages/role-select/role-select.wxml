<view class="container">
  <view class="page-title">选择要进入的身份</view>
  <view class="page-sub">账号「{{userName}}」拥有多个角色，可随时在「我的」里切换。</view>

  <view class="role-list">
    <view
      class="role-card"
      wx:for="{{roles}}"
      wx:key="key"
      style="border-left-color: {{item.color}};"
      data-role="{{item.key}}"
      bindtap="onSelect"
    >
      <view class="role-name">{{item.name}}</view>
      <view class="role-desc">{{item.desc}}</view>
    </view>
  </view>
</view>
