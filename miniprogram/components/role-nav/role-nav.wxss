.role-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #dce5e3;
  padding-top: 10rpx;
  box-shadow: 0 -6rpx 24rpx rgba(15, 61, 62, 0.06);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  color: #5b6b69;
}

.nav-item.active {
  color: #0f3d3e;
}

.icon {
  font-size: 30rpx;
  line-height: 1.2;
}

.label {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.nav-item.active .label {
  font-weight: 600;
}
