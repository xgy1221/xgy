.page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.atmosphere {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 50% at 100% -10%, rgba(217, 119, 6, 0.12), transparent 55%),
    radial-gradient(ellipse 70% 45% at -20% 20%, rgba(15, 61, 62, 0.1), transparent 50%),
    linear-gradient(180deg, #e7efee 0%, var(--bg) 38%, var(--bg) 100%);
}

.page > view:not(.atmosphere),
.page > scroll-view {
  position: relative;
  z-index: 1;
}

.org-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  animation: rise 0.45s ease both;
}

.org-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", serif;
}

.org-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
  letter-spacing: 1rpx;
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", serif;
}

.org-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.child-scroll {
  margin-top: 24rpx;
  white-space: nowrap;
  width: 100%;
  animation: rise 0.5s ease 0.05s both;
}

.child-chip {
  display: inline-flex;
  margin-right: 14rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #5b6b69;
  border: 2rpx solid transparent;
  font-size: 26rpx;
}

.child-chip.active {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

.next-hero,
.next-empty {
  margin-top: 28rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 28rpx;
  color: #fff;
  background:
    linear-gradient(145deg, rgba(26, 92, 94, 0.2) 0%, transparent 40%),
    linear-gradient(160deg, #0f3d3e 0%, #163f40 55%, #1a5c5e 100%);
  box-shadow: 0 18rpx 48rpx rgba(15, 61, 62, 0.22);
  animation: rise 0.55s ease 0.08s both;
}

.next-empty {
  background: linear-gradient(160deg, #1a5c5e 0%, #0f3d3e 100%);
}

.next-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  opacity: 0.78;
  margin-bottom: 12rpx;
}

.next-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", serif;
}

.next-title.soft {
  opacity: 0.95;
  margin-bottom: 12rpx;
}

.next-time {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.next-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.86;
}

.next-meta .dot {
  margin: 0 10rpx;
  opacity: 0.5;
}

.next-foot {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.next-status {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.16);
}

.next-status.ongoing {
  background: rgba(217, 119, 6, 0.35);
}

.next-cta {
  font-size: 26rpx;
  font-weight: 600;
  opacity: 0.92;
}

.day-block {
  margin-top: 36rpx;
  animation: rise 0.55s ease 0.12s both;
}

.day-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.day-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand);
}

.day-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.empty-day {
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(220, 229, 227, 0.9);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.jump-btn {
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.lesson-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(220, 229, 227, 0.85);
}

.lesson-row:last-child {
  border-bottom: none;
}

.lesson-time {
  width: 100rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.lesson-time .t1 {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.lesson-time .t2 {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.lesson-main {
  flex: 1;
  min-width: 0;
}

.lesson-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.tip {
  margin-top: 8rpx;
  color: #b45309;
  font-size: 22rpx;
}

.cal-block {
  margin-top: 40rpx;
  animation: rise 0.55s ease 0.16s both;
}

.cal-block .section-title {
  margin-bottom: 16rpx;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
