.profile {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.profile-main {
  flex: 1;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #0f3d3e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.tag {
  margin-top: 10rpx;
}

.danger {
  color: #b91c1c;
  font-weight: 600;
}

.tip {
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.role-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #dce5e3;
}

.role-item.on {
  background: #f3faf9;
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: 12rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.add-btn {
  margin-top: 24rpx;
}

.link {
  color: var(--brand);
  font-weight: 600;
}

.section-head {
  margin-bottom: 16rpx;
}

.section-head .section-title {
  margin-bottom: 6rpx;
}

.kid-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: var(--shadow);
  margin-bottom: 20rpx;
}

.kid-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.name-row {
  justify-content: flex-start;
  gap: 12rpx;
  align-items: center;
}

.name-row .tag {
  margin-top: 0;
}

.summary {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}

.toggle {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 0 0 12rpx;
  flex-shrink: 0;
}

.kid-body {
  margin-top: 20rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--border);
}

.enroll {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef3f2;
}

.enroll:last-child {
  border-bottom: none;
}

.empty-enroll {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
}

.progress-wrap {
  margin: 16rpx 0 10rpx;
  height: 12rpx;
  background: #e8f2f1;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress {
  height: 100%;
  background: #0f3d3e;
  border-radius: 999rpx;
}

.progress-meta {
  align-items: center;
}

.strong {
  font-weight: 700;
  color: var(--brand);
  font-size: 26rpx;
}

.kid-actions {
  margin-top: 12rpx;
  text-align: right;
}

.empty {
  margin-bottom: 20rpx;
}
