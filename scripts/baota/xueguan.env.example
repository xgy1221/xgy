# 学管云 · 宝塔服务器环境变量示例
# 复制为 /www/wwwroot/xueguan-app/xueguan.env 后改密码与密钥

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DB_URL=jdbc:mysql://127.0.0.1:3306/xgy?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=xgy
DB_PASSWORD=请改成强密码

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 至少 32 字节随机串
JWT_SECRET=请换成 openssl rand -hex 32 的结果

# 生产接真短信后应清空并改校验逻辑；内网演示可暂时保留
SMS_DEMO_CODE=123456
