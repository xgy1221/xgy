<view class="container">
  <view class="page-title">学员情况</view>
  <view class="page-sub">出勤与课堂表现</view>
  <view class="section card">
    <view class="list-item" wx:for="{{list}}" wx:key="id">
      <view>
        <view class="item-title">{{item.name}}</view>
        <view class="muted">{{item.className}} · 出勤 {{item.attendRate}}</view>
      </view>
      <view class="tag">{{item.remark}}</view>
    </view>
  </view>
  <role-nav current="/pages/teacher/students/students" />
</view>
