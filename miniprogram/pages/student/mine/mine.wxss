.profile {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.profile-main {
  flex: 1;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #0f3d3e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.tag {
  margin-top: 10rpx;
}

.danger {
  color: #b91c1c;
  font-weight: 600;
}

.tip {
  margin-top: 8rpx;
  margin-bottom: 4rpx;
  line-height: 1.5;
}

.role-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #dce5e3;
}

.role-item.on {
  background: #f3faf9;
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: 12rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.add-btn {
  margin-top: 20rpx;
}

.link {
  color: var(--brand);
  font-weight: 600;
}

.chip-scroll {
  white-space: nowrap;
  width: 100%;
}

.chip {
  display: inline-flex;
  flex-direction: column;
  margin-right: 14rpx;
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #5b6b69;
  border: 2rpx solid #dce5e3;
  font-size: 26rpx;
  vertical-align: top;
}

.chip.pkg {
  border-radius: 18rpx;
  min-width: 160rpx;
}

.chip.on {
  background: #0f3d3e;
  color: #fff;
  border-color: #0f3d3e;
  font-weight: 600;
}

.chip-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.pkg-summary {
  margin-bottom: 16rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
}

.progress-wrap {
  margin: 16rpx 0 10rpx;
  height: 12rpx;
  background: #e8f2f1;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress {
  height: 100%;
  background: #0f3d3e;
  border-radius: 999rpx;
}

.progress-meta {
  align-items: center;
}

.strong {
  font-weight: 700;
  color: var(--brand);
  font-size: 26rpx;
}

.lesson-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx;
  box-shadow: var(--shadow);
  margin-bottom: 16rpx;
}

.lesson-card .tag {
  margin-top: 0;
}

.eval {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef3f2;
}

.eval-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}

.stars {
  color: #d97706;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.eval-text {
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text);
}

.more-btn {
  margin-top: 8rpx;
}

.empty {
  margin-bottom: 16rpx;
}
