<view class="container">
  <view class="page-title">仅录家长手机号</view>
  <view class="page-sub">可先建白名单，学员信息留给家长登录后自行完善</view>

  <view class="grid-2 section">
    <stat-card label="白名单号码" value="{{total}}" />
    <stat-card label="待完善家庭" value="{{pending}}" hint="尚无学员档案" />
  </view>

  <view class="section card">
    <view class="label">家长手机号</view>
    <input class="input" type="number" maxlength="11" placeholder="11 位手机号" value="{{phone}}" bindinput="onPhone" />
    <view class="label">家长称呼（选填）</view>
    <input class="input" placeholder="如：李女士" value="{{parentName}}" bindinput="onName" />
    <view class="label">备注（选填）</view>
    <input class="input" placeholder="如：渠道意向客户" value="{{note}}" bindinput="onNote" />
    <button class="btn-primary save" bindtap="onAdd">加入白名单</button>
  </view>

  <view class="section">
    <view class="section-title">名单</view>
    <view class="card" wx:for="{{list}}" wx:key="phone">
      <view class="row">
        <view>
          <view class="item-title">{{item.phone}}</view>
          <view class="muted">{{item.parentName || '未填称呼'}} · {{item.note || '无备注'}}</view>
          <view class="muted">学员：{{item.studentText}}</view>
        </view>
        <view class="tag {{item.hasStudent ? 'ok' : 'warn'}}">
          {{item.hasStudent ? '已完善' : '待家长补全'}}
        </view>
      </view>
    </view>
  </view>

  <role-nav current="/pages/academic/home/home" />
</view>
