<view class="page">
  <view class="hero">
    <view class="hero-title">临时加进本课</view>
    <view class="hero-sub">只影响这一节，不改原班。可用姓名或家长手机号搜索。</view>
    <view class="lesson-chip" wx:if="{{lesson.className}}">
      {{lesson.className}} · {{lesson.date}} {{lesson.startTime}}
    </view>
  </view>

  <view class="search-card">
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input
        class="search-input"
        focus="{{autoFocus}}"
        value="{{keyword}}"
        confirm-type="search"
        placeholder="输入学生姓名 / 家长手机号"
        bindinput="onKeyword"
        bindconfirm="onSearch"
      />
      <view class="clear" wx:if="{{keyword}}" bindtap="onClear">清除</view>
    </view>
    <view class="hint-row">
      <text class="hint">支持模糊匹配，如「一然」「138」</text>
      <text class="hint count">库内可加 {{total}} 人</text>
    </view>
  </view>

  <view class="section" wx:if="{{mode === 'suggest' && !keyword}}">
    <view class="section-head">
      <text class="section-title">建议优先</text>
      <text class="section-sub">近期有旷课记录</text>
    </view>
    <view class="empty" wx:if="{{!list.length}}">
      <view class="empty-title">暂无旷课待补</view>
      <view class="empty-desc">请在上方搜索姓名或手机号</view>
    </view>
  </view>

  <view class="section" wx:if="{{mode === 'search'}}">
    <view class="section-head">
      <text class="section-title">搜索结果</text>
      <text class="section-sub">{{list.length}} 人</text>
    </view>
    <view class="empty" wx:if="{{!list.length}}">
      <view class="empty-title">没找到「{{keyword}}」</view>
      <view class="empty-desc">换个关键字，或确认学员已建档</view>
    </view>
  </view>

  <view class="list">
    <view class="row-card" wx:for="{{list}}" wx:key="id">
      <view class="avatar">{{item.avatarText}}</view>
      <view class="info">
        <view class="name-line">
          <text class="name">{{item.studentName}}</text>
          <text class="badge {{item.reasonType === 'absent' ? 'warn' : ''}}">{{item.reasonType === 'absent' ? '旷课补课' : '临时插班'}}</text>
        </view>
        <view class="meta">家长 {{item.phoneMask}}{{item.parentName ? ' · ' + item.parentName : ''}}</view>
        <view class="meta">原班：{{item.homeClassName}}</view>
      </view>
      <button class="add-btn" size="mini" data-id="{{item.id}}" data-name="{{item.studentName}}" bindtap="onAdd">加入</button>
    </view>
  </view>

  <view class="footer-tip">加入后会出现在本课名单，并标注「临补」。下次教务排课仍按原班。</view>
</view>
