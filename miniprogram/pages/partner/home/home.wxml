<view class="container">
  <view class="page-title">合伙人看板</view>
  <view class="page-sub">{{name}} · {{campus}} · 分成 {{shareRatio}}</view>

  <view class="grid-2 section">
    <stat-card label="本月实收" value="¥{{stats.monthReceived}}" />
    <stat-card label="本月分成" value="¥{{stats.shareAmount}}" />
    <stat-card label="新增学员" value="{{stats.monthNewStudents}}" />
    <stat-card label="退费" value="¥{{stats.monthRefund}}" />
  </view>

  <view class="section card">
    <view class="section-title">本月待跟进</view>
    <view class="list-item">
      <text>待缴费订单</text>
      <text class="strong">{{stats.pendingOrders}} 单</text>
    </view>
    <view class="list-item">
      <text>签约额（含欠费）</text>
      <text class="strong">¥{{stats.monthSales}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="list-item" bindtap="goPerf">
      <text>业绩明细（手机快览）</text>
      <text class="link">查看</text>
    </view>
    <view class="list-item" bindtap="goTeam">
      <text>团队贡献概况</text>
      <text class="link">查看</text>
    </view>
  </view>

  <view class="web-hint">
    <view class="web-hint-title">深度财务请用电脑 Web</view>
    <view class="web-hint-text">
      小程序只做巡店快览。校区对比、订单流水、导出对账请用 Web「财务中心」。
    </view>
  </view>

  <role-nav current="/pages/partner/home/home" />
</view>
