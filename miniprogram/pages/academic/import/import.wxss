.cols {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.col-tag {
  padding: 8rpx 16rpx;
  background: #e8f2f1;
  color: #0f3d3e;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tip {
  margin-top: 8rpx;
  line-height: 1.6;
}

.actions button {
  margin-bottom: 16rpx;
}

.danger-border {
  color: #b91c1c;
  border-color: #b91c1c;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.strong {
  font-weight: 700;
  color: #0f3d3e;
}

.error {
  margin-top: 12rpx;
  color: #b91c1c;
  font-size: 24rpx;
}

.family + .family {
  margin-top: 20rpx;
}

.kids {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #dce5e3;
}

.kid {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.kid-name {
  font-weight: 600;
}
