<view class="container">
  <view class="page-title">教务工作台</view>
  <view class="page-sub">{{campus}} · 今日待办</view>
  <view class="grid-2 section">
    <stat-card label="待排课" value="{{pendingSchedule}}" />
    <stat-card label="待缴费报名" value="{{pendingPay}}" />
  </view>

  <view class="section card" bindtap="goImport">
    <view class="row">
      <view>
        <view class="item-title">Excel 导入学员</view>
        <view class="muted">完整字段导入，支持一号多孩</view>
      </view>
      <text class="link">去导入</text>
    </view>
  </view>

  <view class="section card" bindtap="goPhones">
    <view class="row">
      <view>
        <view class="item-title">仅录家长手机号</view>
        <view class="muted">先建白名单，学员信息由家长自助补全</view>
      </view>
      <text class="link">去录入</text>
    </view>
  </view>

  <view class="section card" bindtap="goSetup">
    <view class="row">
      <view>
        <view class="item-title">代录在读学员</view>
        <view class="muted">已在上课的孩子：建档 + 绑教案 + 改剩余课次</view>
      </view>
      <text class="link">去代录</text>
    </view>
  </view>

  <view class="section card" bindtap="goPackages">
    <view class="row">
      <view>
        <view class="item-title">教案 / 课程包管理</view>
        <view class="muted">维护课次数、大纲，供家长勾选报读</view>
      </view>
      <text class="link">去管理</text>
    </view>
  </view>

  <view class="section card" bindtap="goSchedule">
    <view class="row">
      <view>
        <view class="item-title">课表总览</view>
        <view class="muted">按日期看老师有哪些课，并查看师生评价</view>
      </view>
      <text class="link">去查看</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">报名动态</view>
    <view class="card">
      <view class="list-item" wx:for="{{enrolls}}" wx:key="id">
        <view>
          <view class="item-title">{{item.student}}</view>
          <view class="muted">{{item.course}}</view>
        </view>
        <view class="tag warn">{{item.status}}</view>
      </view>
    </view>
  </view>
  <role-nav current="/pages/academic/home/home" />
</view>
