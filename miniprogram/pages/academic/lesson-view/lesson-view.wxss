.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: 48rpx;
  background: #f3f6f5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 61, 62, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f3d3e;
}

.muted {
  margin-top: 6rpx;
  color: #5b6b69;
  font-size: 24rpx;
}

.teacher-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #0f3d3e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.teacher-name {
  font-size: 28rpx;
  font-weight: 600;
}

.tag {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #fef3c7;
  color: #b45309;
}

.tag.ok {
  background: #dcfce7;
  color: #15803d;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stat {
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 61, 62, 0.05);
}

.num {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f3d3e;
}

.label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5b6b69;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.tip {
  margin-bottom: 12rpx;
}

.stu {
  padding: 22rpx 0;
  border-top: 1rpx solid #eef3f2;
}

.stu-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.name-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
}

.pill {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}

.pill.makeup {
  background: #fef3c7;
  color: #b45309;
}

.pill.absent {
  background: #fee2e2;
  color: #b91c1c;
}

.eval-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.eval-box {
  background: #f7fbfa;
  border-radius: 12rpx;
  padding: 16rpx;
  min-height: 140rpx;
}

.eval-label {
  font-size: 22rpx;
  color: #5b6b69;
  margin-bottom: 8rpx;
}

.stars {
  color: #d97706;
  font-size: 26rpx;
  font-weight: 700;
}

.comment {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #14201f;
  line-height: 1.4;
}

.eval-empty {
  font-size: 24rpx;
  color: #8a9a97;
  margin-top: 8rpx;
}
