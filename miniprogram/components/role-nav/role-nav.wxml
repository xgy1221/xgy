<view class="role-nav safe-bottom">
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="nav-item {{item.pagePath === current ? 'active' : ''}}"
    data-path="{{item.pagePath}}"
    bindtap="onTap"
  >
    <view class="icon-wrap">
      <text class="icon">{{item.icon}}</text>
      <view class="dot" wx:if="{{item.pagePath === current}}"></view>
    </view>
    <text class="label">{{item.text}}</text>
  </view>
</view>
