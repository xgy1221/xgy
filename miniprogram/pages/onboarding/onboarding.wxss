.wrap {
  min-height: 100vh;
  padding: 32rpx;
  background:
    radial-gradient(circle at 90% 0%, rgba(217, 119, 6, 0.12), transparent 36%),
    #f3f6f5;
}

.steps {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.step {
  font-size: 24rpx;
  color: #8a9a97;
  white-space: nowrap;
}

.step.on {
  color: #0f3d3e;
  font-weight: 700;
}

.line {
  flex: 1;
  height: 2rpx;
  margin: 0 12rpx;
  background: #dce5e3;
}

.line.on {
  background: #0f3d3e;
}

.panel {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 61, 62, 0.08);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0f3d3e;
}

.sub {
  margin-top: 12rpx;
  color: #5b6b69;
  font-size: 26rpx;
  line-height: 1.6;
}

.phone-box {
  margin: 28rpx 0;
  padding: 20rpx 24rpx;
  background: #e8f2f1;
  border-radius: 12rpx;
  color: #0f3d3e;
  font-weight: 600;
}

.label {
  margin-top: 22rpx;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #5b6b69;
}

.input {
  height: 84rpx;
  border: 2rpx solid #dce5e3;
  border-radius: 14rpx;
  padding: 0 22rpx;
  background: #f8fbfa;
}

.next {
  margin-top: 28rpx;
}

.list {
  margin-top: 24rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #dce5e3;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.muted {
  color: #5b6b69;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.child-scroll {
  white-space: nowrap;
  margin: 24rpx 0;
}

.child-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #dce5e3;
  color: #5b6b69;
}

.child-chip.active {
  background: #0f3d3e;
  color: #fff;
  border-color: #0f3d3e;
}

.pkg {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 2rpx solid #dce5e3;
  background: #fafcfb;
}

.pkg.checked {
  border-color: #0f3d3e;
  background: #e8f2f1;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.right {
  text-align: right;
}

.lessons {
  font-weight: 700;
  color: #0f3d3e;
}

.price {
  margin-top: 6rpx;
  color: #b45309;
  font-weight: 600;
}

.outline {
  margin-top: 12rpx;
  line-height: 1.5;
}
