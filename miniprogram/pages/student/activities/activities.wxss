.page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.atmosphere {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 70% 40% at 100% 0%, rgba(217, 119, 6, 0.14), transparent 50%),
    linear-gradient(180deg, #e9efed 0%, var(--bg) 36%);
}

.page > view:not(.atmosphere),
.page > scroll-view {
  position: relative;
  z-index: 1;
}

.head {
  animation: rise 0.45s ease both;
}

.head-kicker {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

.head-title {
  margin-top: 6rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand);
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", serif;
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.chip-scroll {
  margin-top: 24rpx;
  white-space: nowrap;
  width: 100%;
}

.chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #5b6b69;
  font-size: 26rpx;
}

.chip.on {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

.tabs {
  margin-top: 28rpx;
  display: flex;
  gap: 8rpx;
  animation: rise 0.5s ease 0.05s both;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-bottom: 4rpx solid transparent;
}

.tab.on {
  color: var(--brand);
  font-weight: 700;
  border-bottom-color: var(--accent);
}

.list {
  margin-top: 24rpx;
  animation: rise 0.55s ease 0.08s both;
}

.act {
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 14rpx 40rpx rgba(15, 61, 62, 0.1);
}

.cover {
  min-height: 260rpx;
  padding: 32rpx 28rpx 36rpx;
  color: #fff;
  position: relative;
}

.cover.past {
  min-height: 200rpx;
  opacity: 0.94;
}

.cover-teal {
  background:
    radial-gradient(circle at 90% 20%, rgba(255, 255, 255, 0.14), transparent 40%),
    linear-gradient(145deg, #0f3d3e 0%, #1a5c5e 60%, #2a7a6e 100%);
}

.cover-amber {
  background:
    radial-gradient(circle at 10% 80%, rgba(255, 255, 255, 0.12), transparent 45%),
    linear-gradient(145deg, #78350f 0%, #d97706 65%, #f59e0b 100%);
}

.cover-deep {
  background:
    radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.1), transparent 40%),
    linear-gradient(145deg, #134e4a 0%, #0f766e 55%, #115e59 100%);
}

.cover-cat {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.18);
  margin-bottom: 18rpx;
}

.cover-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", serif;
  max-width: 90%;
}

.cover-date {
  margin-top: 18rpx;
  font-size: 24rpx;
  opacity: 0.88;
}

.act-foot {
  padding: 22rpx 28rpx 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.cta {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand);
}

.cta.done {
  color: var(--success);
}

.act-body {
  padding: 22rpx 28rpx 28rpx;
}

.recap {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.mine-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.empty-block {
  padding: 32rpx 28rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid var(--border);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
