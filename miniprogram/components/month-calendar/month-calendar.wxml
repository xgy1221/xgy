<view class="cal">
  <view class="cal-head">
    <view class="nav" bindtap="onPrev">‹</view>
    <view class="title">{{year}}年{{month}}月</view>
    <view class="nav" bindtap="onNext">›</view>
  </view>
  <view class="week-row">
    <text wx:for="{{weekLabels}}" wx:key="*this" class="week">{{item}}</text>
  </view>
  <view class="days">
    <view wx:for="{{weeks}}" wx:for-item="week" wx:for-index="wIndex" wx:key="wIndex" class="week-line">
      <view
        wx:for="{{week}}"
        wx:for-item="cell"
        wx:key="key"
        class="day {{cell.inMonth ? '' : 'empty'}} {{cell.key === selected ? 'selected' : ''}} {{cell.key === today ? 'today' : ''}} {{markedMap[cell.key] ? 'mark-' + markedMap[cell.key] : ''}}"
        data-key="{{cell.key}}"
        bindtap="onSelect"
      >
        <text wx:if="{{cell.inMonth}}">{{cell.day}}</text>
        <view class="dots" wx:if="{{markedMap[cell.key]}}">
          <view class="dot finished" wx:if="{{markedMap[cell.key] === 'finished' || markedMap[cell.key] === 'mixed'}}"></view>
          <view class="dot upcoming" wx:if="{{markedMap[cell.key] === 'upcoming' || markedMap[cell.key] === 'mixed'}}"></view>
        </view>
      </view>
    </view>
  </view>
  <view class="legend">
    <view class="legend-item"><view class="dot finished"></view><text>已上</text></view>
    <view class="legend-item"><view class="dot upcoming"></view><text>未上</text></view>
  </view>
</view>
