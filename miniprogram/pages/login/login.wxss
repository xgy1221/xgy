.login-page {
  min-height: 100vh;
  padding: 48rpx 36rpx 60rpx;
  background:
    radial-gradient(circle at 12% 10%, rgba(217, 119, 6, 0.16), transparent 40%),
    linear-gradient(160deg, #0f3d3e 0%, #163f40 42%, #f3f6f5 42%);
}

.hero {
  color: #fff;
  padding: 40rpx 8rpx 56rpx;
}

.brand-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
}

.brand {
  margin-top: 28rpx;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.slogan {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.88;
  max-width: 560rpx;
  line-height: 1.6;
}

.panel {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 61, 62, 0.12);
}

.field-label {
  font-size: 26rpx;
  color: #5b6b69;
  margin-bottom: 16rpx;
}

.field {
  height: 88rpx;
  border: 2rpx solid #dce5e3;
  border-radius: 16rpx;
  padding: 0 24rpx;
  background: #f8fbfa;
  margin-bottom: 24rpx;
}

.login-btn {
  height: 88rpx;
  line-height: 88rpx;
}

.tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8a9a97;
  line-height: 1.5;
}

.quick {
  margin-top: 36rpx;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #14201f;
  margin-bottom: 16rpx;
}

.quick-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 61, 62, 0.06);
}

.left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #0f3d3e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #5b6b69;
}

.enter {
  color: #0f3d3e;
  font-size: 26rpx;
  font-weight: 600;
}
