<view class="container">
  <view class="page-title">我的班级</view>
  <view class="page-sub">班级课次与教室信息</view>
  <view class="section">
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="item-title">{{item.name}}</view>
      <view class="muted">学员 {{item.students}} 人 · 教室 {{item.room}}</view>
      <view class="muted">下次上课：{{item.nextLesson}}</view>
    </view>
  </view>
  <role-nav current="/pages/teacher/classes/classes" />
</view>
