<view class="container">
  <view class="profile card">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-main">
      <view class="name">{{name}}</view>
      <view class="muted">{{phone}}</view>
      <view class="tag">{{roleName}}</view>
    </view>
  </view>

  <view class="section card" wx:if="{{multiRole}}">
    <view class="section-title">切换身份</view>
    <view class="muted tip">默认进入上次选择的角色，可随时切换。</view>
    <view
      class="role-item {{item.key === currentRoleKey ? 'on' : ''}}"
      wx:for="{{roleOptions}}"
      wx:key="key"
      data-role="{{item.key}}"
      bindtap="onPickRole"
    >
      <view>
        <view class="role-name">{{item.name}}</view>
        <view class="muted">{{item.desc}}</view>
      </view>
      <view class="tag {{item.key === currentRoleKey ? 'ok' : ''}}">
        {{item.key === currentRoleKey ? '当前' : '进入'}}
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">孩子们的学习</view>
      <view class="muted">点名字切换当前孩子 · 展开看教案进度</view>
    </view>

    <view class="empty card" wx:if="{{!familyLearning.length}}">
      <view class="role-name">还没有学员档案</view>
      <view class="muted tip">添加孩子并绑定教案后，这里会显示已上/总课次。</view>
      <button class="btn-primary add-btn" bindtap="onAddChild">添加学员</button>
    </view>

    <view class="kid-card" wx:for="{{familyLearning}}" wx:key="id">
      <view class="kid-head" data-id="{{item.id}}" bindtap="onSwitchChild">
        <view>
          <view class="row name-row">
            <view class="role-name">{{item.studentName}}</view>
            <view class="tag ok" wx:if="{{item.isCurrent}}">当前</view>
            <view class="tag" wx:else>切换</view>
          </view>
          <view class="muted">{{item.orgName || '机构'}} · {{item.grade || '未填年级'}}</view>
          <view class="summary">{{item.summaryText}}</view>
        </view>
        <view class="toggle" data-id="{{item.id}}" catchtap="onToggleKid">
          {{item.expanded ? '收起' : '展开'}}
        </view>
      </view>

      <view class="kid-body" wx:if="{{item.expanded}}">
        <view class="enroll empty-enroll" wx:if="{{!item.enrollments.length}}">
          <view class="muted">尚未报读教案</view>
          <view class="link" data-id="{{item.id}}" catchtap="goAddPackages">去选教案</view>
        </view>
        <view class="enroll" wx:for="{{item.enrollments}}" wx:for-item="en" wx:key="id">
          <view class="row">
            <view class="item-title">{{en.packageName}}</view>
            <view class="tag {{en.status === '学习中' ? 'ok' : 'warn'}}">{{en.status}}</view>
          </view>
          <view class="muted">{{en.subject}} · {{en.grade}}</view>
          <view class="progress-wrap">
            <view class="progress" style="width: {{en.progress}}%;"></view>
          </view>
          <view class="row progress-meta">
            <text class="strong">已上 {{en.usedLessons}} / 教案共 {{en.totalLessons}} 课</text>
            <text class="muted">剩余 {{en.remainLessons}}</text>
          </view>
        </view>
        <view class="kid-actions" wx:if="{{item.enrollments.length}}">
          <text class="link" data-id="{{item.id}}" catchtap="goAddPackages">继续添加教案</text>
        </view>
      </view>
    </view>

    <button class="btn-ghost add-btn" bindtap="onAddChild" wx:if="{{familyLearning.length}}">
      添加 / 完善学员
    </button>
  </view>

  <view class="section card">
    <view class="section-title">快捷入口</view>
    <view class="list-item" bindtap="goSchedule">
      <text>全部课次列表</text>
      <text class="link">查看</text>
    </view>
    <view class="list-item" bindtap="goActivities">
      <text>比赛报名与往期赛果</text>
      <text class="link">进入</text>
    </view>
  </view>

  <view class="section card">
    <view class="list-item">
      <text>当前角色</text>
      <text>{{roleName}}</text>
    </view>
    <view class="list-item" bindtap="onLogout">
      <text>退出登录</text>
      <text class="danger">退出</text>
    </view>
  </view>

  <role-nav current="/pages/student/mine/mine" />
</view>
