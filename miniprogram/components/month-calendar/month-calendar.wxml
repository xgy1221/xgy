<view class="cal">
  <view class="cal-head">
    <view class="nav" bindtap="onPrev">‹</view>
    <view class="title">{{year}}年{{month}}月</view>
    <view class="nav" bindtap="onNext">›</view>
  </view>
  <view class="week-row">
    <text wx:for="{{weekLabels}}" wx:key="*this" class="week">{{item}}</text>
  </view>
  <view class="days">
    <view wx:for="{{weeks}}" wx:for-item="week" wx:for-index="wIndex" wx:key="wIndex" class="week-line">
      <view
        wx:for="{{week}}"
        wx:for-item="cell"
        wx:key="key"
        class="day {{cell.inMonth ? '' : 'empty'}} {{cell.key === selected ? 'selected' : ''}} {{markedMap[cell.key] ? 'marked' : ''}} {{cell.key === today ? 'today' : ''}}"
        data-key="{{cell.key}}"
        bindtap="onSelect"
      >
        <text wx:if="{{cell.inMonth}}">{{cell.day}}</text>
        <view class="dot" wx:if="{{markedMap[cell.key]}}"></view>
      </view>
    </view>
  </view>
</view>
