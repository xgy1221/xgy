<view class="container">
  <view class="profile card">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-main">
      <view class="name">{{name}}</view>
      <view class="muted">{{phone}}</view>
      <view class="tag">{{roleName}}</view>
    </view>
  </view>

  <view class="section card" wx:if="{{multiRole}}">
    <view class="section-title">切换身份</view>
    <view
      class="role-item {{item.key === currentRoleKey ? 'on' : ''}}"
      wx:for="{{roleOptions}}"
      wx:key="key"
      data-role="{{item.key}}"
      bindtap="onPickRole"
    >
      <view>
        <view class="role-name">{{item.name}}</view>
        <view class="muted">{{item.desc}}</view>
      </view>
      <view class="tag {{item.key === currentRoleKey ? 'ok' : ''}}">
        {{item.key === currentRoleKey ? '当前' : '进入'}}
      </view>
    </view>
  </view>

  <!-- 1. 切孩子 -->
  <view class="section">
    <view class="section-title">选择孩子</view>
    <view class="empty card" wx:if="{{!children.length}}">
      <view class="role-name">还没有学员</view>
      <button class="btn-primary add-btn" bindtap="onAddChild">添加学员</button>
    </view>
    <scroll-view scroll-x class="chip-scroll" wx:else>
      <view
        class="chip {{item.id === currentStudentId ? 'on' : ''}}"
        wx:for="{{children}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSwitchChild"
      >{{item.chipText}}</view>
    </scroll-view>
  </view>

  <!-- 2. 切教案 -->
  <view class="section" wx:if="{{children.length}}">
    <view class="section-title">选择教案</view>
    <view class="empty card" wx:if="{{!packages.length}}">
      <view class="role-name">该孩子还没有报读教案</view>
      <view class="muted tip">绑定教案后，可按教案查看课次与老师评价。</view>
      <button class="btn-primary add-btn" bindtap="goAddPackages">去选教案</button>
    </view>
    <scroll-view scroll-x class="chip-scroll" wx:else>
      <view
        class="chip pkg {{item.id === currentPackageId ? 'on' : ''}}"
        wx:for="{{packages}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSwitchPackage"
      >
        <view>{{item.chipText}}</view>
        <view class="chip-sub">{{item.usedLessons}}/{{item.totalLessons}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 3. 当前教案进度 + 课次/评价 -->
  <view class="section" wx:if="{{currentPackage}}">
    <view class="pkg-summary card">
      <view class="row">
        <view class="item-title">{{currentPackage.name}}</view>
        <view class="tag {{currentPackage.status === '学习中' ? 'ok' : 'warn'}}">{{currentPackage.status}}</view>
      </view>
      <view class="muted">{{currentPackage.subject}}</view>
      <view class="progress-wrap">
        <view class="progress" style="width: {{currentPackage.progress}}%;"></view>
      </view>
      <view class="row progress-meta">
        <text class="strong">已上 {{currentPackage.usedLessons}} / 教案共 {{currentPackage.totalLessons}} 课</text>
        <text class="muted">剩余 {{currentPackage.remainLessons}}</text>
      </view>
      <view class="muted tip">老师评价 {{evalCount}} 条 · 课次较多时先显示最近 {{shownCount}} 节</view>
    </view>

    <view class="empty card" wx:if="{{!displayLessons.length}}">
      <view class="role-name">该教案下还没有课次记录</view>
      <view class="muted">上课并评价后，会出现在这里。</view>
    </view>

    <view
      class="lesson-card"
      wx:for="{{displayLessons}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goLesson"
    >
      <view class="row">
        <view>
          <view class="item-title">{{item.dateText}}</view>
          <view class="muted">{{item.startTime}}-{{item.endTime}} · {{item.teacherName}}</view>
          <view class="muted">{{item.className}} · {{item.room}}</view>
        </view>
        <view class="tag {{item.status === 'finished' ? 'ok' : 'warn'}}">{{item.statusText}}</view>
      </view>

      <view class="eval" wx:if="{{item.hasTeacherEval}}">
        <view class="eval-label">老师评价</view>
        <view class="stars">{{item.teacherStars}}</view>
        <view class="eval-text" wx:if="{{item.teacherComment}}">{{item.teacherComment}}</view>
      </view>
      <view class="eval muted" wx:elif="{{item.status === 'finished'}}">老师暂未评价</view>
      <view class="eval muted" wx:else>上完课后可查看老师评价</view>
    </view>

    <button class="btn-ghost more-btn" wx:if="{{hasMore}}" bindtap="onLoadMore">
      加载更多课次（还有 {{lessonRows.length - shownCount}} 节）
    </button>
  </view>

  <view class="section card">
    <view class="section-title">更多</view>
    <view class="muted tip">在读学员的教案建议由教务/老师代录；家长可在此补选或查看。</view>
    <view class="list-item" bindtap="goAddPackages" wx:if="{{children.length}}">
      <text>为当前孩子添加教案</text>
      <text class="link">添加</text>
    </view>
    <view class="list-item" bindtap="onAddChild">
      <text>添加学员</text>
      <text class="link">去添加</text>
    </view>
    <view class="list-item" bindtap="goSchedule">
      <text>全部课次</text>
      <text class="link">查看</text>
    </view>
    <view class="list-item">
      <text>当前角色</text>
      <text>{{roleName}}</text>
    </view>
    <view class="list-item" bindtap="onLogout">
      <text>退出登录</text>
      <text class="danger">退出</text>
    </view>
  </view>

  <role-nav current="/pages/student/mine/mine" />
</view>
