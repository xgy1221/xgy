<view class="container">
  <view class="page-title">我的课表</view>
  <view class="page-sub">
    {{studentName}} · 点日期查看当天课程（有课日期会打点）
  </view>

  <view class="section" wx:if="{{children.length > 1}}">
    <scroll-view scroll-x class="child-scroll">
      <view
        class="child-chip {{item.id === currentStudentId ? 'active' : ''}}"
        wx:for="{{children}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSwitchChild"
      >{{item.studentName}}</view>
    </scroll-view>
  </view>

  <view class="section">
    <month-calendar
      selected="{{selectedDate}}"
      markedDates="{{markedDates}}"
      bind:select="onSelectDate"
    />
  </view>

  <view class="section">
    <view class="section-title">{{displayDate}}</view>
    <view class="card" wx:if="{{!lessons.length}}">
      <view class="muted">这天没有课</view>
    </view>
    <view
      class="card lesson"
      wx:for="{{lessons}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="row">
        <view>
          <view class="item-title">{{item.packageName}}</view>
          <view class="muted">{{item.startTime}}-{{item.endTime}} · {{item.room}}</view>
          <view class="muted">{{item.className}} · {{item.teacherName}}</view>
        </view>
        <view class="tag {{item.status === 'finished' ? 'ok' : 'warn'}}">
          {{item.statusText}}
        </view>
      </view>
      <view class="muted tip" wx:if="{{item.myType === 'makeup'}}">临时补课（原班：{{item.homeClassName}}）</view>
      <view class="muted tip" wx:if="{{item.needRate}}">可评价老师（可选，不评也能消课）</view>
    </view>
  </view>

  <role-nav current="/pages/student/home/home" />
</view>
