<view class="page">
  <view class="atmosphere"></view>

  <view class="head">
    <view class="head-kicker">{{orgName || '机构活动'}}</view>
    <view class="head-title">比赛</view>
    <view class="head-sub">为 {{studentName}} 报名参赛，或翻看往期赛果</view>
  </view>

  <scroll-view scroll-x class="chip-scroll" wx:if="{{children.length > 1}}">
    <view
      class="chip {{item.id === currentStudentId ? 'on' : ''}}"
      wx:for="{{children}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onSwitchChild"
    >{{item.chipText}}</view>
  </scroll-view>

  <view class="tabs">
    <view class="tab {{tab === 'open' ? 'on' : ''}}" data-tab="open" bindtap="onTab">报名中</view>
    <view class="tab {{tab === 'past' ? 'on' : ''}}" data-tab="past" bindtap="onTab">往期</view>
    <view class="tab {{tab === 'mine' ? 'on' : ''}}" data-tab="mine" bindtap="onTab">
      已报{{myCount ? ' · ' + myCount : ''}}
    </view>
  </view>

  <view class="swap {{contentReady ? 'in' : 'out'}}">
  <view class="list" wx:if="{{tab === 'open'}}">
    <view class="empty-block" wx:if="{{!openList.length}}">
      <view class="empty-title">暂无开放报名的比赛</view>
      <view class="muted">机构发布思维赛、口语赛等后会出现在这里，可直接为孩子报名。</view>
    </view>
    <view
      class="act"
      wx:for="{{openList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="cover cover-{{item.coverTone}}">
        <view class="cover-cat">{{item.coverLabel}}</view>
        <view class="cover-title">{{item.title}}</view>
        <view class="cover-date">{{item.dateText}}</view>
      </view>
      <view class="act-foot">
        <view class="muted">{{item.campus}} · 余 {{item.remain}} 席 · {{item.feeText}}</view>
        <view class="cta {{item.signed ? 'done' : ''}}">
          {{item.signed ? '已报名' : '为' + studentName + '报名'}}
        </view>
      </view>
    </view>
  </view>

  <view class="list" wx:if="{{tab === 'past'}}">
    <view class="empty-block" wx:if="{{!pastList.length}}">
      <view class="empty-title">还没有往期赛果</view>
      <view class="muted">比赛结束后会放回顾与亮点，方便家长翻看孩子的表现。</view>
    </view>
    <view
      class="act"
      wx:for="{{pastList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="cover cover-{{item.coverTone}} past">
        <view class="cover-cat">赛果</view>
        <view class="cover-title">{{item.title}}</view>
      </view>
      <view class="act-body">
        <view class="muted">{{item.dateText}}</view>
        <view class="recap" wx:if="{{item.recap}}">{{item.recap}}</view>
      </view>
    </view>
  </view>

  <view class="list" wx:if="{{tab === 'mine'}}">
    <view class="empty-block" wx:if="{{!myList.length}}">
      <view class="empty-title">还没有参赛记录</view>
      <view class="muted">在「报名中」选一场比赛，为当前孩子报名即可。</view>
    </view>
    <view
      class="mine-row"
      wx:for="{{myList}}"
      wx:key="signupId"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view>
        <view class="item-title">{{item.title}}</view>
        <view class="muted">{{item.dateText}} · {{item.studentName}}</view>
      </view>
      <view class="tag ok">已报名</view>
    </view>
  </view>
  </view>

  <role-nav current="/pages/student/activities/activities" />
</view>
