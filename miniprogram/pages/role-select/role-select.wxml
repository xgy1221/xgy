<view class="page">
  <view class="atmosphere"></view>
  <view class="head anim-rise">
    <view class="kicker">多身份账号</view>
    <view class="title">选择要进入的身份</view>
    <view class="sub">「{{userName}}」可选下方角色。选过后会记住，下次默认进入；也可在「我的」随时切换。</view>
  </view>

  <view class="role-list">
    <view
      class="role-card tapable anim-rise {{item.key === lastRole ? 'last' : ''}}"
      style="border-left-color: {{item.color}}; animation-delay: {{index * 0.06}}s"
      wx:for="{{roles}}"
      wx:key="key"
      data-role="{{item.key}}"
      bindtap="onSelect"
    >
      <view class="row">
        <view class="role-name">{{item.name}}</view>
        <view class="tag ok" wx:if="{{item.key === lastRole}}">上次使用</view>
        <view class="enter" wx:else>进入 ›</view>
      </view>
      <view class="role-desc">{{item.desc}}</view>
    </view>
  </view>
</view>
