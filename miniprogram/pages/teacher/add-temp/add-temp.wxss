.page {
  min-height: 100vh;
  padding: 0 0 48rpx;
  background:
    radial-gradient(circle at 88% 0%, rgba(217, 119, 6, 0.14), transparent 34%),
    linear-gradient(180deg, #163f40 0%, #163f40 168rpx, #f3f6f5 168rpx);
}

.hero {
  padding: 36rpx 32rpx 8rpx;
  color: #fff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.88;
  line-height: 1.55;
  max-width: 620rpx;
}

.lesson-chip {
  display: inline-flex;
  margin-top: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
}

.search-card {
  margin: 28rpx 24rpx 8rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(15, 61, 62, 0.12);
}

.search-box {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f3f8f7;
  border: 2rpx solid #dce5e3;
}

.search-icon {
  font-size: 32rpx;
  color: #5b6b69;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
}

.clear {
  font-size: 24rpx;
  color: #0f3d3e;
  font-weight: 600;
  padding: 8rpx 4rpx 8rpx 16rpx;
}

.hint-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  gap: 16rpx;
}

.hint {
  font-size: 22rpx;
  color: #8a9a97;
}

.hint.count {
  color: #5b6b69;
}

.section {
  padding: 20rpx 28rpx 0;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #14201f;
}

.section-sub {
  font-size: 22rpx;
  color: #8a9a97;
}

.list {
  padding: 8rpx 24rpx 0;
}

.row-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 14rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 61, 62, 0.06);
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #0f3d3e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  color: #14201f;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e8f2f1;
  color: #1a5c5e;
}

.badge.warn {
  background: #fef3c7;
  color: #b45309;
}

.meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5b6b69;
}

.add-btn {
  margin: 0;
  padding: 0 22rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: #0f3d3e;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.add-btn::after {
  border: none;
}

.empty {
  margin: 24rpx 24rpx 0;
  padding: 48rpx 24rpx;
  text-align: center;
  background: #fff;
  border-radius: 18rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #14201f;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a9a97;
}

.footer-tip {
  margin: 28rpx 36rpx 0;
  font-size: 22rpx;
  color: #8a9a97;
  line-height: 1.6;
  text-align: center;
}
