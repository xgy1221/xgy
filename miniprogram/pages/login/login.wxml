<view class="login-page">
  <view class="hero">
    <view class="brand-mark">学</view>
    <view class="brand">学管云</view>
    <view class="slogan">培训机构多角色协同：家长 · 老师 · 教务 · 合伙人 · 管理</view>
  </view>

  <view class="panel">
    <view class="field-label">手机号登录（演示）</view>
    <input
      class="field"
      type="number"
      maxlength="11"
      placeholder="输入演示手机号"
      value="{{phone}}"
      bindinput="onPhoneInput"
    />
    <button class="btn-primary login-btn" bindtap="onLogin">进入系统</button>
    <view class="tip">任意 11 位手机号可体验家长入驻。小程序主战场：家长 / 老师 / 教务。合伙、管理员也可登，只看业绩与全校快览；深度财务与配置用 Web。多角色演示：13800000004，可在「我的」切换。</view>
  </view>

  <view class="quick">
    <view class="quick-title">快捷体验账号</view>
    <view
      class="quick-item"
      wx:for="{{accounts}}"
      wx:key="phone"
      data-phone="{{item.phone}}"
      bindtap="onQuickLogin"
    >
      <view class="left">
        <view class="avatar">{{item.avatarText}}</view>
        <view>
          <view class="name">{{item.name}}</view>
          <view class="meta">{{item.phone}} · {{item.roleText}}</view>
        </view>
      </view>
      <text class="enter">进入</text>
    </view>
  </view>
</view>
