.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: 60rpx;
  background: #f3f6f5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 61, 62, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f3d3e;
  margin-bottom: 8rpx;
}

.muted {
  color: #5b6b69;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.tag {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #fef3c7;
  color: #b45309;
}

.tag.ok {
  background: #dcfce7;
  color: #15803d;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.stu,
.cand {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #dce5e3;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.mini {
  margin: 0;
  padding: 0 18rpx;
  line-height: 52rpx;
  height: 52rpx;
  font-size: 22rpx;
}

.tip {
  margin: 8rpx 0 16rpx;
  line-height: 1.5;
}

.stars {
  margin: 16rpx 0;
}

.star {
  font-size: 48rpx;
  color: #dce5e3;
  margin-right: 8rpx;
}

.star.on {
  color: #d97706;
}

.input {
  height: 80rpx;
  border: 2rpx solid #dce5e3;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: #f8fbfa;
}

.btn-ghost {
  margin-top: 12rpx;
}
