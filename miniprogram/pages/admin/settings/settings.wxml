<view class="container">
  <view class="page-title">系统设置</view>
  <view class="page-sub">基础开关（前端演示）</view>
  <view class="section card">
    <view class="list-item"><text>允许家长自助约课</text><switch checked="{{settings.selfBook}}" bindchange="onToggle" data-key="selfBook" color="#0F3D3E"/></view>
    <view class="list-item"><text>课时不足提醒</text><switch checked="{{settings.hourAlert}}" bindchange="onToggle" data-key="hourAlert" color="#0F3D3E"/></view>
    <view class="list-item"><text>合伙人业绩可见退费</text><switch checked="{{settings.partnerRefund}}" bindchange="onToggle" data-key="partnerRefund" color="#0F3D3E"/></view>
  </view>
  <role-nav current="/pages/admin/settings/settings" />
</view>
