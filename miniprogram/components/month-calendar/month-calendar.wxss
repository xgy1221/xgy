.cal {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 16rpx 12rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 61, 62, 0.08);
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 16rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f3d3e;
}

.nav {
  width: 64rpx;
  height: 64rpx;
  text-align: center;
  line-height: 64rpx;
  font-size: 40rpx;
  color: #0f3d3e;
  border-radius: 50%;
  transition: background 0.15s ease, transform 0.15s ease;
}

.nav:active {
  background: #e8f2f1;
  transform: scale(0.92);
}

.week-row,
.week-line {
  display: flex;
}

.week,
.day {
  width: 14.285%;
  text-align: center;
}

.week {
  font-size: 22rpx;
  color: #8a9a97;
  padding: 8rpx 0 12rpx;
}

.day {
  height: 78rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #14201f;
  border-radius: 14rpx;
  transition: background 0.18s ease, color 0.18s ease, transform 0.15s ease;
}

.day:active {
  transform: scale(0.92);
}

.day.empty {
  pointer-events: none;
}

.day.today {
  font-weight: 700;
}

/* 未上课：琥珀底 */
.day.mark-upcoming:not(.selected) {
  background: rgba(217, 119, 6, 0.16);
  color: #92400e;
  font-weight: 600;
}

/* 已上课：青绿底 */
.day.mark-finished:not(.selected) {
  background: rgba(21, 128, 61, 0.14);
  color: #166534;
  font-weight: 600;
}

/* 当天既有已上又有未上 */
.day.mark-mixed:not(.selected) {
  background: linear-gradient(135deg, rgba(21, 128, 61, 0.16), rgba(217, 119, 6, 0.18));
  color: #0f3d3e;
  font-weight: 700;
}

.day.selected {
  background: #0f3d3e;
  color: #fff;
  transform: scale(1.04);
  box-shadow: 0 6rpx 16rpx rgba(15, 61, 62, 0.22);
}

.dots {
  position: absolute;
  bottom: 6rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 6rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.dot.finished {
  background: #15803d;
}

.dot.upcoming {
  background: #d97706;
}

.day.selected .dot.finished {
  background: #86efac;
}

.day.selected .dot.upcoming {
  background: #fde68a;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  padding: 18rpx 8rpx 8rpx;
  border-top: 1rpx solid #e8f0ee;
  margin-top: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #5b6b69;
}

.legend-item .dot {
  width: 12rpx;
  height: 12rpx;
}
