.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: 60rpx;
  background: #f3f6f5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 61, 62, 0.06);
  animation: xgy-rise 0.4s ease both;
}

.card:nth-child(2) {
  animation-delay: 0.05s;
}

.card:nth-child(3) {
  animation-delay: 0.1s;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f3d3e;
  margin-bottom: 8rpx;
}

.muted {
  color: #5b6b69;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.tag {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #fef3c7;
  color: #b45309;
}

.tag.ok {
  background: #dcfce7;
  color: #15803d;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.stu {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #dce5e3;
}

.name-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.pill {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #e8f2f1;
  color: #1a5c5e;
}

.pill.makeup {
  background: #fef3c7;
  color: #b45309;
}

.pill.absent {
  background: #fee2e2;
  color: #b91c1c;
}

.right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.mini {
  margin: 0;
  padding: 0 18rpx;
  line-height: 52rpx;
  height: 52rpx;
  font-size: 22rpx;
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx dashed #b7ccc9;
  background: #f7fbfa;
}

.entry-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.entry-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #0f3d3e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f3d3e;
}

.entry-arrow {
  font-size: 40rpx;
  color: #0f3d3e;
  font-weight: 300;
}

.tip {
  margin: 12rpx 0 0;
  line-height: 1.5;
}

.stars {
  margin: 16rpx 0;
}

.star {
  font-size: 48rpx;
  color: #dce5e3;
  margin-right: 8rpx;
  transition: color 0.15s ease, transform 0.15s ease;
  display: inline-block;
}

.star.on {
  color: #d97706;
  transform: scale(1.12);
}

.star:active {
  transform: scale(0.9);
}

.entry:active {
  transform: scale(0.985);
  opacity: 0.95;
}

.input {
  height: 80rpx;
  border: 2rpx solid #dce5e3;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: #f8fbfa;
}

.btn-ghost {
  margin-top: 12rpx;
}
